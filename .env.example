# The backend this dev server / build talks to. Copy this file to .env
# (gitignored) and set your own value — see "Configuration" in
# README.md.
VITE_ORIGIN=https://weda-backend.example.com/

# How `npm run dev` signs in. Production builds ignore both values and always
# use the deployed shared-cookie login.
#   authcode  Authorization Code + PKCE against <VITE_ORIGIN>/identity. Needs a
#             public client whose redirect URI is
#             http://localhost:9001/auth/callback and whose post-logout
#             redirect URI is http://localhost:9001/ — see README.md.
#   cookie    (default) the shared-cookie login, as deployed.
VITE_AUTH_MODE=authcode
# The client id of that public client (it has no secret).
VITE_AUTH_CLIENT_ID=
